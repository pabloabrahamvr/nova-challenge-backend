# Copy to .env and fill in. Never commit .env.

# Required. 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUDIT_ENCRYPTION_KEY=

# Audit records are appended here (JSON Lines). Keep it under data/ (gitignored).
AUDIT_FILE_PATH=data/audit.jsonl

PORT=3000
NODE_ENV=development

# Mock AI provider
PROVIDER_DELAY_MS=2000
PROVIDER_TIMEOUT_MS=5000

# Circuit breaker
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_MS=10000

# Failure simulation for demos: the first N provider calls fail, then calls succeed.
# 0 = off. Refused at startup when NODE_ENV=production.
PROVIDER_FAIL_FIRST_N=0
