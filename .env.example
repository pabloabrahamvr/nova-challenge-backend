# Copy to .env for local runs / non-secret tunables. Never commit .env (or any .env.* except this file).

# --- Encryption key (required): 32 random bytes, base64-encoded -------------------------------------------
# Generate:  openssl rand -base64 32
# Provide it ONE of two ways (setting both is an error):
#   * Docker / production: put it in a file and point AUDIT_ENCRYPTION_KEY_FILE at it. compose.yaml mounts
#     ./secrets/audit_encryption_key (git-ignored) at /run/secrets/audit_encryption_key for you.
#   * Local development: set it inline below.
AUDIT_ENCRYPTION_KEY=
# AUDIT_ENCRYPTION_KEY_FILE=/run/secrets/audit_encryption_key

# --- Audit log (JSON Lines). Keep it under data/ (git-ignored) ---------------------------------------------
AUDIT_FILE_PATH=data/audit.jsonl
# Writes are rejected (HTTP 500) once the file reaches this size. There is no rotation.
AUDIT_MAX_FILE_BYTES=104857600

# --- Server ------------------------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Per-client-IP limit on POST /secure-inquiry; 0 disables. Behind a proxy, configure Express "trust proxy".
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# --- Mock AI provider --------------------------------------------------------------------------------------
PROVIDER_DELAY_MS=2000
# A provider call slower than this is aborted and counts as a failure.
PROVIDER_TIMEOUT_MS=5000
# Max provider calls in flight; extra requests get 503 "Service Busy" immediately.
PROVIDER_MAX_CONCURRENCY=50

# --- Circuit breaker ---------------------------------------------------------------------------------------
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_MS=10000

# --- Failure simulation for demos --------------------------------------------------------------------------
# The first N provider calls fail, then calls succeed. 0 = off. Refused at startup when NODE_ENV=production.
PROVIDER_FAIL_FIRST_N=0
